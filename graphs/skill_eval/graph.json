{
  "version": "2.0",
  "name": "skill_eval",
  "description": "Automated blind skill evaluation in a sandbox: supports fine-grained assertion-level grading and statistics against official grading standards.",
  "description-zh": "[正在调试适配新架构]自动化技能沙盒盲测：支持断言级 (Assertion) 的细粒度评判与官方 grading 标准统计。",
  "global_schema": {
    "host_skill_md_path": {
      "type": "string",
      "required": true
    },
    "workplace_dir": {
      "type": "string",
      "required": true
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "expected_output": {
      "type": "string",
      "required": true
    }
  },
  "nodes": [
    {
      "id": "nd_input",
      "type": "task_input",
      "name": "全局输入",
      "position": [
        -500,
        100
      ],
      "config": {
        "global_vars": [
          {
            "name": "host_skill_md_path",
            "required": true
          },
          {
            "name": "workplace_dir",
            "required": true
          },
          {
            "name": "prompt",
            "required": true
          },
          {
            "name": "expected_output",
            "required": true
          }
        ]
      }
    },
    {
      "id": "nd_tpl_sys",
      "type": "template_renderer",
      "name": "组装System指令",
      "position": [
        100,
        -50
      ],
      "config": {}
    },
    {
      "id": "nd_msg_sys",
      "type": "message_card_builder",
      "name": "构建System卡片",
      "position": [
        400,
        -50
      ],
      "config": {
        "role": "system"
      }
    },
    {
      "id": "nd_msg_user",
      "type": "message_card_builder",
      "name": "构建User卡片",
      "position": [
        400,
        200
      ],
      "config": {
        "role": "user"
      }
    },
    {
      "id": "nd_append_msgs",
      "type": "appender",
      "name": "合并消息上下文",
      "position": [
        700,
        50
      ],
      "config": {}
    },
    {
      "id": "nd_agent_exec",
      "type": "agent_loop",
      "name": "Agent-测试工人",
      "position": [
        1000,
        50
      ],
      "config": {}
    },
    {
      "id": "nd_tpl_eval",
      "type": "template_renderer",
      "name": "组装QA裁判指令",
      "position": [
        1400,
        150
      ],
      "config": {}
    },
    {
      "id": "nd_msg_eval",
      "type": "message_card_builder",
      "name": "构建User卡片-裁判",
      "position": [
        1700,
        150
      ],
      "config": {
        "role": "user"
      }
    },
    {
      "id": "nd_agent_eval",
      "type": "agent_loop",
      "name": "Agent-QA裁判",
      "position": [
        2000,
        150
      ],
      "config": {
        "task_done_info": {
          "assertion_results": "一个JSON对象数组。包含字段：text (断言文本), passed (true/false), evidence (给出判定的具体证据，必须具体到事实)。请严格逐一评估清单上的每一条断言。",
          "summary": "一个统计字典，必须包含 passed (通过数)、failed (失败数)、total (断言总数)、pass_rate (通过率，0~1)。请根据 assertion_results 计算。"
        }
      }
    },
    {
      "id": "nd_out",
      "type": "task_output",
      "name": "全局输出",
      "position": [
        2800,
        100
      ],
      "config": {
        "target_vars": [
          {
            "name": "exec_summary"
          },
          {
            "name": "eval_result"
          }
        ]
      }
    },
    {
      "id": "string_system_role",
      "type": "string",
      "name": "角色-系统",
      "position": [
        350,
        -220
      ],
      "config": {
        "value": "system"
      }
    },
    {
      "id": "string_tpl_nd_tpl_sys",
      "type": "string",
      "name": "模板-组装System指令",
      "position": [
        -280,
        -170
      ],
      "config": {
        "value": "你是一个沙盒环境中的测试执行专家。\n\n【你的专属隔离工作目录】\n{{workplace_dir}}\n注意：所有的操作必须在这个目录下进行！\n\n【待测试技能 SOP】\n源码位于 {{host_skill_md_path}}（通常即 {{workplace_dir}}/SKILL.md）。请先用 Bash 读取其内容，理解要测试的标准化流程 (SOP) 并严格执行，切勿编造技能内容。\n\n💡 严格要求：你所有的测试产出和文件修改，必须真实地保存在你的工作目录内！不要仅仅在聊天中用文字回复结果。完成最终产出后，再调用 task_done 输出简要总结。"
      }
    },
    {
      "id": "string_tpl_nd_tpl_eval",
      "type": "string",
      "name": "模板-组装QA裁判指令",
      "position": [
        1020,
        30
      ],
      "config": {
        "value": "你是一个严格的 QA 评估专家。以下是测试工人在沙盒中执行任务后的情况。\n\n【我们期望达成的核心结果与断言清单 (Assertions)】\n{{expected_output}}\n\n【执行工人的自我总结】\n{{summary}}\n\n【任务发生的工作目录】\n{{workplace_dir}}\n\n请使用 Bash 工具检查该目录下的实际产出文件，严格逐条核对上述【硬性断言检查清单】中的每一项！\n\n💡 格式强制要求：\n核对完毕后，请调用 task_done 工具，在 summary 参数中输出一个 JSON 字典，必须同时包含 `assertion_results` 数组与 `summary` 统计字典。请严格参考以下示例：\n{\n  \"assertion_results\": [\n    {\"text\": \"The bar chart has labeled axes\", \"passed\": false, \"evidence\": \"Y-axis is labeled 'Revenue' but X-axis has no label.\"}\n  ],\n  \"summary\": {\n    \"passed\": 0,\n    \"failed\": 1,\n    \"total\": 1,\n    \"pass_rate\": 0.0\n  }\n}"
      }
    }
  ],
  "edges": [
    {
